#!/bin/sh
# Enable with: git config core.hooksPath .githooks
set -e

npx tsc --noEmit
npx biome check .
node scripts/route-surface.mjs --check

# OKF lint is a machine-local skill, not a dependency of this repo.
okf=~/.claude/skills/okf/scripts/okf.py
# One path per call: the linter reads the first argument only.
[ -f "$okf" ] && python3 "$okf" lint --quiet docs && python3 "$okf" lint --quiet compat
