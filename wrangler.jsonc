{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workwarden",
  "main": "src/index.ts",
  // Capped by the workerd bundled with miniflare; a later date fails the test
  // run with ERR_FUTURE_COMPATIBILITY_DATE. Raise it when wrangler updates.
  "compatibility_date": "2026-08-15",
  // postgres.js needs it (STACK.md §2.2); harmless until Phase 1.
  "compatibility_flags": ["nodejs_compat"],
  // cpuTime is only readable from invocation logs -- workerd freezes clocks
  // inside the isolate, so Phase 0 cannot time itself. See docs/PHASE0.md.
  // Neon project flat-heart-18148850, branch production, eu-central-1.
  // localConnectionString is what dev and tests use; the id is never touched
  // locally.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eace91137a9649659e5fcd5011063257",
      // Query caching is off, but it is NOT set here -- wrangler rejects a
      // "caching" key in this file. It lives on the Hyperdrive config:
      //   wrangler hyperdrive update <id> --caching-disabled
      "localConnectionString": "postgresql://postgres:dev@127.0.0.1:5432/workwarden"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 }
  }
  // account_id is deliberately absent: this repo is public.
  // Set CLOUDFLARE_ACCOUNT_ID in the environment instead.
}
