{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workwarden",
  "main": "src/index.ts",
  // Capped by the workerd bundled with miniflare; a later date fails the test
  // run with ERR_FUTURE_COMPATIBILITY_DATE. Raise it when wrangler updates.
  "compatibility_date": "2026-08-15",

  // workers.dev only. vault.amirsalmani.com is the live Vaultwarden until the
  // cutover; nothing in this file may name that host before then.
  "workers_dev": true,
  "preview_urls": false,

  // The vault. One SQLite database on D1; migrations in db/migrations, applied
  // with `npm run migrate` (local) or `npm run migrate:remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workwarden",
      "database_id": "8fa407f4-2e94-452d-a6b1-c6ea0278a4ff",
      "migrations_dir": "db/migrations"
    }
  ],

  // The one address that may register, once. Config, not a secret.
  "vars": { "OWNER_EMAIL": "hi@amirsalmani.com" },

  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true }
  }

  // account_id is deliberately absent: this repo is public.
  // Set CLOUDFLARE_ACCOUNT_ID in the environment instead.
}
