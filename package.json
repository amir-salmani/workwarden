{
  "name": "workwarden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "routes": "node scripts/route-surface.mjs",
    "routes:check": "node scripts/route-surface.mjs --check",
    "migrate": "wrangler d1 migrations apply workwarden --local",
    "cf-typegen": "wrangler types",
    "migrate:remote": "wrangler d1 migrations apply workwarden --remote"
  },
  "dependencies": {
    "age-encryption": "^0.3.1",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@bitwarden/cli": "^2026.6.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.130.0"
  }
}
